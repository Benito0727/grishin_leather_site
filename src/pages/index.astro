---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Filters from '../components/Filters.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductModal from '../components/ProductModal.astro';
import Footer from '../components/Footer.astro';
import { getProducts } from '../lib/sanity';

const products = await getProducts();
const categories = [...new Set(products.map(p => p.category).filter(Boolean))];

const selectedCategory = Astro.url.searchParams.get('category');

const filteredProducts = selectedCategory 
  ? products.filter(p => p.category === selectedCategory)
  : products;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Кожаные изделия ручной работы</title>
    <script src="/scripts/modal.js" type="module"></script>
  </head>

  <body>
    <Header />

    <main>
      <h2 class="section-title">Сейчас в наличии</h2>

      <Filters 
        categories={categories} 
        selectedCategory={selectedCategory} 
      />

      {filteredProducts.length === 0 ? (
        <p class="empty">
          {selectedCategory 
            ? `В категории "${selectedCategory}" пока нет товаров.` 
            : 'Пока нет товаров в наличии. Загляни позже!'}
        </p>
      ) : (
        <div class="grid">
          {filteredProducts.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      )}
    </main>

    <Footer />

    <!-- Модалка с галереей -->
    <ProductModal products={products} />
  </body>
</html>