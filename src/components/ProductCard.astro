---
import { imageUrlFor } from '../lib/sanity';
import ContactDropdown from './ContactDropdown.astro';

export interface Props {
  product: {
    _id: string;
    title: string;
    category: string;
    price: string;
    description: string;
    mainImage?: any;
    gallery?: any[];
    ozonLink?: string;
    wbLink?: string;
    ymLink?: string;
    contactTelegram?: string;
    contactWhatsapp?: string;
    contactMax?: string;
  };
}

const { product } = Astro.props;

const categoryNames: Record<string, string> = {
  'accessories': 'Аксессуары',
  'belts': 'Ремни',
  'wallets': 'Кошельки',
  'bags': 'Сумки',
  'covers': 'Обложки',
};

const categoryName = categoryNames[product.category] || product.category;

// Формируем данные для модалки
const productData = {
  title: product.title,
  category: product.category,
  categoryName: categoryName,
  price: product.price,
  description: product.description,
  mainImageUrl: product.mainImage ? imageUrlFor(product.mainImage) : null,
  gallery: product.gallery 
    ? product.gallery.map(img => ({ url: imageUrlFor(img) }))
    : [],
  ozonLink: product.ozonLink || null,
  wbLink: product.wbLink || null,
  ymLink: product.ymLink || null,
  contactTelegram: product.contactTelegram || null,
  contactWhatsapp: product.contactWhatsapp || null,
  contactMax: product.contactMax || null,
};
---

<article 
  class="card" 
  data-id={product._id}
  data-category={product.category}
  data-product={JSON.stringify(productData)}
>
  {product.mainImage && (
    <img
      src={imageUrlFor(product.mainImage)}
      alt={product.title}
      loading="lazy"
    />
  )}

  <div class="card-body">
    <p class="category">{categoryName}</p>
    <h3 class="title">{product.title}</h3>
    <p class="description">{product.description}</p>
    <p class="price">{product.price}</p>

    <div class="actions" onclick="event.stopPropagation()">
      {product.ozonLink && (
        <a
          class="btn btn-ozon"
          href={product.ozonLink}
          target="_blank"
          rel="noopener noreferrer"
        >
          Купить на Ozon
        </a>
      )}

      {product.wbLink && (
        <a
          class="btn btn-wb"
          href={product.wbLink}
          target="_blank"
          rel="noopener noreferrer"
        >
          Купить на Wildberries
        </a>
      )}

      {product.ymLink && (
        <a
          class="btn btn-ym"
          href={product.ymLink}
          target="_blank"
          rel="noopener noreferrer"
        >
          Купить на Яндекс Маркете
        </a>
      )}

      {!product.ozonLink && !product.wbLink && !product.ymLink && (
        <ContactDropdown
          telegram={product.contactTelegram}
          whatsapp={product.contactWhatsapp}
          max={product.contactMax}
        />
      )}
    </div>
  </div>
</article>

<style>
  .card {
    background: #fffaf3;
    border: 1px solid #e4d4c3;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(43, 29, 22, 0.08);
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 40px rgba(43, 29, 22, 0.15);
  }

  .card.hidden {
    display: none;
  }

  .card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .category {
    margin: 0;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #8b6a55;
  }

  .title {
    margin: 0;
    font-size: 22px;
    line-height: 1.25;
  }

  .description {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: #5d473b;
    flex: 1;
  }

  .price {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    color: #2b1d16;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  .btn-ozon {
    background: #0055ff;
    color: white;
    padding: 12px 16px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .btn-ozon:hover {
    transform: translateY(-1px);
    opacity: 0.95;
  }

  .btn-wb {
    background: #cb11ab;
    color: white;
    padding: 12px 16px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .btn-wb:hover {
    transform: translateY(-1px);
    opacity: 0.95;
  }

  .btn-ym {
    background: #ffcc00;
    color: #2b1d16;
    padding: 12px 16px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .btn-ym:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }
</style>